# Frontend API and MCP Configuration
# Copy this to .env.local and adjust values as needed

# Backend API URL
VITE_API_URL=http://localhost:8000

# MCP Server URL (if running separately, otherwise same as API)
VITE_MCP_URL=http://localhost:8000/mcp

# Optional: API request timeout (milliseconds)
VITE_API_TIMEOUT=30000

# Optional: Enable debug logging
VITE_DEBUG=false
